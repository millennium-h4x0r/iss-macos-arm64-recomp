+
+#define KK_LARGE_BO_CACHE_BYTES (1024ull * 1024 * 1024)
+
+VkResult
+kk_alloc_cached_bo(struct kk_device *dev, struct vk_object_base *log_obj,
+                   uint64_t size_B, uint64_t align_B, struct kk_bo **bo_out)
+{
+   simple_mtx_lock(&dev->large_bo_cache.mutex);
+   int best = -1;
+   for (uint32_t i = 0; i < dev->large_bo_cache.count; i++) {
+      struct kk_bo *bo = dev->large_bo_cache.bos[i];
+      if (bo->size_B >= size_B && bo->size_B <= 2 * size_B &&
+          (align_B == 0 || (bo->gpu % align_B) == 0) &&
+          (best < 0 || bo->size_B < dev->large_bo_cache.bos[best]->size_B))
+         best = (int)i;
+   }
+   if (best >= 0) {
+      struct kk_bo *bo = dev->large_bo_cache.bos[best];
+      dev->large_bo_cache.bos[best] =
+         dev->large_bo_cache.bos[--dev->large_bo_cache.count];
+      dev->large_bo_cache.bytes -= bo->size_B;
+      simple_mtx_unlock(&dev->large_bo_cache.mutex);
+      *bo_out = bo;
+      return VK_SUCCESS;
+   }
+   simple_mtx_unlock(&dev->large_bo_cache.mutex);
+   return kk_alloc_bo(dev, log_obj, size_B, align_B, bo_out);
+}
+
+void
+kk_release_cached_bo(struct kk_device *dev, struct kk_bo *bo)
+{
+   simple_mtx_lock(&dev->large_bo_cache.mutex);
+   while (dev->large_bo_cache.count &&
+          (dev->large_bo_cache.count == ARRAY_SIZE(dev->large_bo_cache.bos) ||
+           dev->large_bo_cache.bytes + bo->size_B > KK_LARGE_BO_CACHE_BYTES)) {
+      /* Evict the oldest entry. */
+      struct kk_bo *old = dev->large_bo_cache.bos[0];
+      memmove(&dev->large_bo_cache.bos[0], &dev->large_bo_cache.bos[1],
+              (dev->large_bo_cache.count - 1) * sizeof(old));
+      dev->large_bo_cache.count--;
+      dev->large_bo_cache.bytes -= old->size_B;
+      kk_destroy_bo(dev, old);
+   }
+   if (bo->size_B <= KK_LARGE_BO_CACHE_BYTES) {
+      dev->large_bo_cache.bos[dev->large_bo_cache.count++] = bo;
+      dev->large_bo_cache.bytes += bo->size_B;
+      bo = NULL;
+   }
+   simple_mtx_unlock(&dev->large_bo_cache.mutex);
+   if (bo)
+      kk_destroy_bo(dev, bo);
+}
+
+void
+kk_bo_cache_finish(struct kk_device *dev)
+{
+   for (uint32_t i = 0; i < dev->large_bo_cache.count; i++)
+      kk_destroy_bo(dev, dev->large_bo_cache.bos[i]);
+   dev->large_bo_cache.count = 0;
+   dev->large_bo_cache.bytes = 0;
+   simple_mtx_destroy(&dev->large_bo_cache.mutex);
+}
