+/* GPU busy time (union of command buffer GPU intervals), for KK_RESIDENCY_STATS. */
+#include <os/lock.h>
+static os_unfair_lock kk_gpu_time_lock = OS_UNFAIR_LOCK_INIT;
+static double kk_gpu_busy, kk_gpu_last_end;
+static unsigned kk_gpu_buffers;
+
+void
+mtl_take_gpu_busy_time(double *busy_s, unsigned *buffers)
+{
+   os_unfair_lock_lock(&kk_gpu_time_lock);
+   *busy_s = kk_gpu_busy;
+   *buffers = kk_gpu_buffers;
+   kk_gpu_busy = 0;
+   kk_gpu_buffers = 0;
+   os_unfair_lock_unlock(&kk_gpu_time_lock);
+}
+
+static void
+kk_note_gpu_interval(double start, double end)
+{
+   if (end <= start)
+      return;
+   os_unfair_lock_lock(&kk_gpu_time_lock);
+   if (end > kk_gpu_last_end) {
+      kk_gpu_busy += end - (start > kk_gpu_last_end ? start : kk_gpu_last_end);
+      kk_gpu_last_end = end;
+   }
+   kk_gpu_buffers++;
+   os_unfair_lock_unlock(&kk_gpu_time_lock);
+}
+
 void
 mtl_commit_options_add_feedback_handler(mtl_commit_options *options,
                                         mtl_feedback_handler_callback callback,
@@ -38,6 +69,7 @@ mtl_commit_options_add_feedback_handler(mtl_commit_options *options,
                            ? (enum mtl_command_queue_error)error.code
                            : MTL_COMMAND_QUEUE_ERROR_NONE,
             };
+            kk_note_gpu_interval(feedback.GPUStartTime, feedback.GPUEndTime);
             callback(&feedback_data);
          }
       }];
