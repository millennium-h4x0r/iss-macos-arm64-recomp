+/* KK_RESIDENCY_STATS=1: every 2 s, print residency commits per submit and their cost. */
+struct kk_residency_stats kk_residency_stats;
+
+static void
+kk_residency_stats_tick(uint64_t now)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = getenv("KK_RESIDENCY_STATS") != NULL;
+   struct kk_residency_stats *st = &kk_residency_stats;
+   if (!enabled)
+      return;
+   if (!st->window_start)
+      st->window_start = now;
+   if (now - st->window_start < 2000000000ull)
+      return;
+   fprintf(stderr,
+           "KK residency: %u submits, %u commits (%.2f ms avg, %.2f ms max commit; "
+           "%.2f ms avg request), +%u/-%u allocations, %u bo allocs (%.1f MB), "
+           "%u bo frees\n",
+           st->submits, st->commits,
+           st->commits ? st->commit_ns / 1e6 / st->commits : 0.0, st->commit_max_ns / 1e6,
+           st->commits ? st->request_ns / 1e6 / st->commits : 0.0, st->adds, st->removes,
+           st->bo_allocs, st->bo_alloc_bytes / 1048576.0, st->bo_frees);
+   fprintf(stderr,
+           "KK encoders: %u render, %u compute, %u render passes split for compute; "
+           "%u geometry-shader draws, %u tessellation draws; %u vkCmdBeginRendering, "
+           "%u barrier splits, %u attachment-map restarts\n",
+           st->render_encoders, st->compute_encoders, st->render_breaks_for_compute,
+           st->gs_draws, st->tess_draws, st->begin_rendering, st->barrier_splits,
+           st->attachment_map_restarts);
+   {
+      double busy;
+      unsigned buffers;
+      mtl_take_gpu_busy_time(&busy, &buffers);
+      fprintf(stderr, "KK GPU: busy %.0f ms of %.0f ms (%u command buffers)\n", busy * 1e3,
+              (now - st->window_start) / 1e6, buffers);
+   }
+   fprintf(stderr, "KK submit: %.0f ms CPU in vkQueueSubmit (max %.1f ms)\n",
+           st->submit_ns / 1e6, st->submit_max_ns / 1e6);
+   fprintf(stderr, "KK barriers: %u encoder-start barriers kept, %u skipped; %u vkCmdPipelineBarrier2\n",
+           st->barriers_kept, st->barriers_skipped, st->pipeline_barriers);
+   for (unsigned i = 0; i < 16 && st->barrier_kinds[i].n; i++)
+      fprintf(stderr, "KK barriers:   src 0x%llx dst 0x%llx: %u (%u image, %u buffer, %u memory)\n",
+              (unsigned long long)st->barrier_kinds[i].src,
+              (unsigned long long)st->barrier_kinds[i].dst, st->barrier_kinds[i].n,
+              st->barrier_kinds[i].imgs, st->barrier_kinds[i].bufs, st->barrier_kinds[i].mems);
+   fprintf(stderr, "KK passes: %.0f MB loaded, %.0f MB stored by vkCmdBeginRendering passes, %llu with clears; %.0f MB device memory in private heaps\n",
+           st->load_bytes / 1048576.0, st->store_bytes / 1048576.0,
+           (unsigned long long)st->clear_passes, st->private_bytes_live / 1048576.0);
+   for (unsigned i = 0; i < 64; i++)
+      if (st->by_type[i])
+         fprintf(stderr, "KK residency:   object type %u: %u bo allocs, %.1f MB\n", i,
+                 st->by_type[i], st->by_type_bytes[i] / 1048576.0);
+   uint64_t start = now;
+   const int64_t private_live = st->private_bytes_live;
+   memset(st, 0, sizeof(*st));
+   st->window_start = start;
+   st->private_bytes_live = private_live;
+}
+
+/* GPU watchdog. Residency commits and queue submits take the kernel's GPU lock, which
+ * WindowServer needs to draw. Under load a single one can take seconds, and a game that
+ * keeps submitting then starves WindowServer until its 40 s watchdog kills it, taking the
+ * desktop session along. When a commit or submit is slow, this throttles submissions for a
+ * while so other GPU clients get the lock. KK_GPU_WATCHDOG=0 disables it. */
+static uint64_t kk_watchdog_cooldown_until;
+static uint64_t kk_watchdog_last_log;
+
+static bool
+kk_watchdog_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *e = getenv("KK_GPU_WATCHDOG");
+      enabled = !(e && e[0] == '0');
+   }
+   return enabled;
+}
+
+void
+kk_gpu_watchdog_record(const char *what, uint64_t duration_ns)
+{
+   const uint64_t slow_ns = 100000000ull; /* 100 ms */
+   if (!kk_watchdog_enabled() || duration_ns < slow_ns)
+      return;
+   uint64_t now = os_time_get_nano();
+   uint64_t cooldown = MIN2(duration_ns * 20, 15000000000ull);
+   uint64_t until = now + cooldown;
+   if (until > p_atomic_read(&kk_watchdog_cooldown_until))
+      p_atomic_set(&kk_watchdog_cooldown_until, until);
+   if (now - kk_watchdog_last_log > 1000000000ull) {
+      kk_watchdog_last_log = now;
+      fprintf(stderr,
+              "KK GPU watchdog: %s held the GPU for %.0f ms; throttling submissions for "
+              "%.1f s so WindowServer can draw\n",
+              what, duration_ns / 1e6, cooldown / 1e9);
+   }
+}
+
+void
+kk_gpu_watchdog_before_submit(void)
+{
+   if (!kk_watchdog_enabled())
+      return;
+   uint64_t until = p_atomic_read(&kk_watchdog_cooldown_until);
+   if (until && os_time_get_nano() < until)
+      os_time_sleep(20000); /* 20 ms between submissions while cooling down */
+}
+
 void
 kk_device_make_resources_resident(struct kk_device *dev)
 {
    simple_mtx_lock(&dev->residency_set.mutex);
-   mtl_residency_set_commit(dev->residency_set.handle);
-   mtl_residency_set_request_residency(dev->residency_set.handle);
+   kk_residency_stats.submits++;
+   /* The set is attached to every queue (kk_queue.c), so Metal keeps it resident for each
+    * command buffer; only changes need a commit. */
+   if (dev->residency_set.dirty) {
+      uint64_t t0 = os_time_get_nano();
+      mtl_residency_set_commit(dev->residency_set.handle);
+      uint64_t t1 = os_time_get_nano();
+      mtl_residency_set_request_residency(dev->residency_set.handle);
+      uint64_t t2 = os_time_get_nano();
+      dev->residency_set.dirty = false;
+      kk_residency_stats.commits++;
+      kk_residency_stats.commit_ns += t1 - t0;
+      kk_residency_stats.request_ns += t2 - t1;
+      if (t2 - t0 > kk_residency_stats.commit_max_ns)
+         kk_residency_stats.commit_max_ns = t2 - t0;
+      kk_gpu_watchdog_record("residency commit", t2 - t0);
+   }
+   kk_residency_stats_tick(os_time_get_nano());
    simple_mtx_unlock(&dev->residency_set.mutex);
 }
 
